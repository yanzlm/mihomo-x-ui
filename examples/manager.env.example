# Exact public origin. HTTPS is required except for localhost development.
M_ORIGIN=https://proxy.example.com
M_CONFIG=/etc/mihomo/config.yaml
M_HOME=/var/lib/mihomo
M_ADMIN_DATA=/var/lib/mihomo-subscriptions
M_CORE=/usr/local/bin/mihomo
M_API=http://127.0.0.1:19091
M_ADMIN_PORT=19092
# Existing Linux account/group used to read Mihomo provider files.
M_FILE_USER=mihomo
M_FILE_GROUP=mihomo
# Used only when starting with no HTTP subscription providers.
M_TARGET_GROUPS=PROXY
# Include ALL of this VPS's public IPs and entry hostnames to avoid loops.
# Documentation-only IPs below MUST be replaced with your own addresses.
M_BLOCKED_HOSTS=203.0.113.10,2001:db8::10,proxy.example.com
# Optional if the subscription provider requires a specific client User-Agent:
# M_USER_AGENT=mihomo
