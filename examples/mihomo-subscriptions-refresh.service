[Unit]
Description=Refresh due Mihomo subscriptions
After=network-online.target mihomo.service
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/mihomo-subscriptions.env
WorkingDirectory=/opt/mihomo-subscription-manager
ExecStart=/opt/mihomo-subscription-manager/.venv/bin/python server.py --refresh-due
User=root
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/etc/mihomo /var/lib/mihomo /var/lib/mihomo-subscriptions
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER
UMask=0077
MemoryMax=256M
